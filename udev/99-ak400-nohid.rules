# DeepCool AK400 DIGITAL: firmware resets if its HID IN endpoint is polled.
# Keep usbhid off it; ak400-display talks to it via usbfs.
ACTION=="bind", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_interface", DRIVER=="usbhid", ATTRS{idVendor}=="3633", ATTRS{idProduct}=="0001", RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/usbhid/unbind'"
